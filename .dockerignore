node_modules
**/node_modules

# Build artifacts & caches
dist
**/dist
.next
**/.next
.turbo
**/.turbo

# Git & editor metadata
.git
.gitignore
.cursor
.vscode
.idea
*.log

# Secrets & local environment files
.env
.env.*
!.env.example

# Dockerfiles & Compose files (not needed inside images)
Dockerfile*
docker-compose*.yml
compose*.yaml
README.md